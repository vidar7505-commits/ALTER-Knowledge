# Browser-safe values. NEXT_PUBLIC_ variables are included in client bundles.
# For local development, copy this file to .env.local and replace these values
# with the API URL and anon key printed by `npm run supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only value. Never prefix this value with NEXT_PUBLIC_ or expose it to
# browser code. Use only the local service-role key printed by status here.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
