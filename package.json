{
  "name": "alter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"*.{json,mjs,ts}\" \"README.md\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"docs/engineering/IMPLEMENTATION_STATUS.md\" \"docs/engineering/implementation/**/*.md\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"*.{json,mjs,ts}\" \"README.md\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"docs/engineering/IMPLEMENTATION_STATUS.md\" \"docs/engineering/implementation/**/*.md\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.11.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
